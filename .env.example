# Copy to .env (gitignored). mise loads it; docker-compose overrides the hosts for its containers.

# Django
DJANGO_SECRET_KEY=dev-only-not-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=http://localhost:5173
SESSION_COOKIE_NAME=sessionid
CSRF_COOKIE_NAME=csrftoken
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Optional Google OAuth credentials for local sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres and Redis (from docker-compose)
DATABASE_URL=postgres://lecturecast:lecturecast@localhost:5432/lecturecast
REDIS_URL=redis://localhost:6379/0

# S3: RustFS locally (MinIO-compatible)
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=lecturecast-media

# Email: Mailpit locally (web UI on http://localhost:8025)
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Pipeline API keys
ANTHROPIC_API_KEY=
SPEECHIFY_API_KEY=
